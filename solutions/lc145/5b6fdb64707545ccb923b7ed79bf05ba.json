  "code": "class Solution:\n    def postorderTraversal(self, root):\n        # 先说明变量含义，再完成你的实现\n        ans=[]\n        def dfs(node):\n            if node is None:\n                return \n            \n            dfs(node.left)\n            dfs(node.right)\n            ans.append(node.val)\n\n        dfs(root)\n        return ans\n",
