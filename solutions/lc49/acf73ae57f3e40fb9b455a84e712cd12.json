  "code": "class Solution:\n    def groupAnagrams(self, strs: list[str]) -> list[list[str]]:\n        ans={}\n        for word in strs:\n            # 这种排序得到的结果是list，需要将其转为dict\n            key = \"\".join(sorted(word))\n            # ans中没出现就先存入key，用空进行占位\n            if key not in ans:\n                ans[key]=[]\n            # 如果排序后出现过就直接将其加入到对应字典里\n            ans[key].append(word)\n        # 将字典的结果转回list\n        return list(ans.values())\n",
