  "code": "import heapq\nclass Solution:\n    def topKFrequent(self, nums: list[int], k: int) -> list[int]:\n        count = {}\n\n        for num in nums:\n            count[num] = count.get(num, 0) + 1\n\n        heap = []\n\n        for num, freq in count.items():\n            heapq.heappush(heap, (freq, num))\n\n            if len(heap) > k:\n                heapq.heappop(heap)\n\n        ans = []\n        for freq, num in heap:\n            ans.append(num)\n\n        return ans",
