  "code": "class Solution:\n    def maxArea(self, height):\n        left = 0\n        right = len(height)-1\n        max_area = 0\n        while left<right:\n            max_area = max(max_area,min(height[left],height[right])*(right-left))\n            if height[left]<height[right]:\n                left+=1\n            else:\n                right-=1\n        return max_area  \n    ",
