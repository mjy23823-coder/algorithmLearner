  "code": "class Solution:\n    def invertTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\n        # 当前节点为空\n        if root == None:\n            return None\n        # 递归左右子树\n        self.invertTree(root.left)\n        self.invertTree(root.right)\n        # 交换左右子树节点\n        root.left,root.right = root.right,root.left\n\n        return root",
