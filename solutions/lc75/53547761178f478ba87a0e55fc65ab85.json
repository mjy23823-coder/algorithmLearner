  "code": "class Solution:\n    def sortColors(self, nums: list[int]) -> None:\n        \"\"\"\n        Do not return anything, modify nums in-place instead.\n        \"\"\"\n        left = 0\n        right = len(nums)-1\n\n        while left<right:\n            if nums[left]>nums[right]:\n                nums[left],nums[right]=nums[right],nums[left]\n                right-=1\n            else:\n                left+=1\n\n        \n",
