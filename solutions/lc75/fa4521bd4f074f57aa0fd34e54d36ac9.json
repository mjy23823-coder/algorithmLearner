  "code": "class Solution:\n       def sortColors(self, nums: list[int]) -> None:\n           left = 0\n           i = 0\n           right = len(nums) - 1\n\n           while i <= right:\n               if nums[i] == 0:\n                   nums[left], nums[i] = nums[i], nums[left]\n                   left += 1\n                   i += 1\n\n               elif nums[i] == 1:\n                   i += 1\n               else:  # nums[i] == 2\n                   nums[i], nums[right] = nums[right], nums[i]\n                   right -= 1\n\n\n\n\n\n\n\n\n\n\n\n\n",
