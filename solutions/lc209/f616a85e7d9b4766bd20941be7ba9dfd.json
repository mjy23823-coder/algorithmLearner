  "code": "class Solution:\n    def minSubArrayLen(self, target, nums):\n        min_window_size = float(\"inf\")\n        sum=0\n        left =0\n        for right in range(0,len(nums)):\n            sum+=nums[right]\n            while sum>=target:\n                min_window_size=min(min_window_size,right-left+1)\n                sum-=nums[left]\n                left+=1\n\n        if min_window_size == float(\"inf\"):\n            return 0\n        return min_window_size\n",
